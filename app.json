{
  "expo": {
    "name": "MV-3 PRO Tâches",
    "slug": "mv3-taches",
    "version": "1.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#0C1830",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "ch.mv3pro.taches",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0C1830"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "MV-3 PRO Tâches accède à vos photos pour joindre des images à une tâche.",
          "cameraPermission": "MV-3 PRO Tâches utilise l'appareil photo pour documenter un chantier."
        }
      ],
      [
        "@react-native-voice/voice",
        {
          "microphonePermission": "MV-3 PRO Tâches utilise le micro pour dicter vos tâches.",
          "speechRecognitionPermission": "MV-3 PRO Tâches analyse votre dictée pour créer la tâche."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F59E0B",
          "defaultChannel": "taches"
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}
